# Backend орчны хувьсагчид (.env файл болгон хуулж тохируулна)

# ЗААВАЛ ШААРДЛАГАТАЙ: Gemini (google-genai) API түлхүүр.
# Энэ утга байхгүй бол get_genai_client() RuntimeError шидэж,
# /ask, /analyze-excel зэрэг бүх Gemini-д тулгуурласан endpoint ажиллахгүй.
# https://aistudio.google.com/apikey хаягаас үнэ төлбөргүй авах боломжтой.
GEMINI_API_KEY=your_gemini_api_key_here

GRAPHRAG_API_KEY=your_secret_key_here
GRAPHRAG_ROOT=.
QUERY_TIMEOUT=120
